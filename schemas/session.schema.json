{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "session_id",
    "repository",
    "root",
    "gitDir",
    "commonDir",
    "remote",
    "branch",
    "head",
    "bound_at",
    "product"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "gitDir": {
      "type": "string",
      "minLength": 1
    },
    "commonDir": {
      "type": "string",
      "minLength": 1
    },
    "remote": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "head": {
      "type": "string",
      "minLength": 1
    },
    "bound_at": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
