{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "scope",
    "status",
    "run_id",
    "task_id",
    "attempt_id",
    "session_id",
    "task_ids",
    "product",
    "contract",
    "identity",
    "findings",
    "requirement_refs",
    "runtime_ref",
    "executions"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "kind": {
      "enum": ["review", "audit"]
    },
    "scope": {
      "enum": ["task", "final", "milestone"]
    },
    "status": {
      "enum": ["PASS", "NEEDS_FIX", "UNVERIFIED", "BLOCKED"]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "task_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "product": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contract": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "findings": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "message", "resolved"],
        "properties": {
          "severity": {
            "enum": ["critical", "major", "minor"]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "resolved": {
            "type": "boolean"
          }
        }
      },
      "uniqueItems": true
    },
    "requirement_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "runtime_ref": {
      "type": "string",
      "minLength": 1
    },
    "executions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "run_id", "attempt_id"],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "attempt_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
