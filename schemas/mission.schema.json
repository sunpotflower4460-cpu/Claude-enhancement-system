{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "original",
    "requirements",
    "profile",
    "target",
    "shared"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "original": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "profile": {
      "enum": [
        "backend",
        "web-app",
        "game"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "gitDir",
        "remote",
        "branch"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "gitDir": {
          "type": "string",
          "minLength": 1
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "shared": {
      "type": "string",
      "minLength": 1
    }
  }
}
