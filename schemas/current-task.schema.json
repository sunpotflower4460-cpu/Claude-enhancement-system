{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "stage",
    "run_id",
    "task_id",
    "attempt_id",
    "attempt",
    "active",
    "failures",
    "fingerprint",
    "owner",
    "history",
    "sprint_task_id",
    "run_started_at",
    "attempt_history"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "stage": {
      "enum": [
        "IDLE",
        "ARCHITECTURE",
        "PLAN",
        "IMPLEMENT",
        "REVIEW",
        "VERIFY",
        "AUDIT",
        "BLOCKED"
      ]
    },
    "run_id": {
      "type": ["string", "null"]
    },
    "task_id": {
      "type": ["string", "null"]
    },
    "attempt_id": {
      "type": ["string", "null"]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "active": {
      "type": "boolean"
    },
    "failures": {
      "type": "integer",
      "minimum": 0
    },
    "fingerprint": {
      "type": ["string", "null"]
    },
    "owner": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["pid", "host", "start"],
          "properties": {
            "pid": {
              "type": "integer",
              "minimum": 1
            },
            "host": {
              "type": "string",
              "minLength": 1
            },
            "start": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "history": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "at", "fingerprint", "note"],
        "properties": {
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    },
    "sprint_task_id": {
      "type": ["string", "null"]
    },
    "run_started_at": {
      "type": ["string", "null"]
    },
    "attempt_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "task_id", "attempt_id"],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "attempt_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
