{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "nonce",
    "check_id",
    "run_id",
    "task_id",
    "attempt_id",
    "session_id",
    "tool",
    "assertions",
    "artifacts",
    "details"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "kind": {
      "enum": ["test", "build", "behavior", "visual", "play", "api"]
    },
    "nonce": {
      "type": "string",
      "minLength": 1
    },
    "check_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "expected", "actual"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["PASS", "FAIL", "UNVERIFIED"]
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "actual": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "media_type"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "details": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "test"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "type": "object",
            "additionalProperties": false,
            "required": ["total", "passed", "failed", "skipped"],
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 1
              },
              "passed": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              },
              "skipped": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "build"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "type": "object",
            "additionalProperties": false,
            "required": ["exit_code", "outputs"],
            "properties": {
              "exit_code": {
                "type": "integer"
              },
              "outputs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "api"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requests"],
            "properties": {
              "requests": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "method",
                    "url",
                    "status",
                    "expected_status",
                    "response_sha256",
                    "response_artifact"
                  ],
                  "properties": {
                    "method": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https?://"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599
                    },
                    "expected_status": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599
                    },
                    "response_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "response_artifact": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "behavior"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actions"],
            "properties": {
              "actions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["input", "before", "after", "expected"],
                  "properties": {
                    "input": {
                      "type": "string",
                      "minLength": 1
                    },
                    "before": {
                      "type": "string",
                      "minLength": 1
                    },
                    "after": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expected": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "visual"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "type": "object",
            "additionalProperties": false,
            "required": ["browser", "viewport", "captures", "inspections"],
            "properties": {
              "browser": {
                "type": "string",
                "minLength": 1
              },
              "viewport": {
                "type": "object",
                "additionalProperties": false,
                "required": ["width", "height"],
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "captures": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "inspections": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "play"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "engine",
              "inputs",
              "progress",
              "outcome",
              "expected_outcome",
              "captures"
            ],
            "properties": {
              "engine": {
                "type": "string",
                "minLength": 1
              },
              "inputs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "progress": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "outcome": {
                "type": "string",
                "minLength": 1
              },
              "expected_outcome": {
                "type": "string",
                "minLength": 1
              },
              "captures": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  ]
}
