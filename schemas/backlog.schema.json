{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "items"],
  "properties": {
    "version": {
      "const": 2
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirement_refs",
          "status",
          "dependencies",
          "check_refs",
          "execution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "not": {
              "const": "mission"
            }
          },
          "requirement_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "status": {
            "enum": ["UNVERIFIED", "PASS", "FAIL", "BLOCKED"]
          },
          "dependencies": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "check_refs": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "execution": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["run_id", "attempt_id", "started_at"],
                "properties": {
                  "run_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "attempt_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "started_at": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      },
      "uniqueItems": true
    }
  }
}
